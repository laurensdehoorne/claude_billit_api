{
  "mcpServers": {
    "billit": {
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/billit_mcp.py"],
      "env": {
        "BILLIT_API_KEY": "${BILLIT_API_KEY:-}",
        "BILLIT_PARTY_ID": "${BILLIT_PARTY_ID:-}",
        "BILLIT_ENV": "${BILLIT_ENV:-sandbox}",
        "BILLIT_READ_ONLY": "${BILLIT_READ_ONLY:-false}"
      }
    }
  }
}
